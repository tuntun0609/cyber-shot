# 复制为 .env 后填写；bun run start 会自动同步为 .dev.vars
# 生产环境：公开配置写入 wrangler.jsonc 的 vars，密钥用 wrangler secret put

# 素材图片域名（无结尾斜杠），需在 Cloudflare 启用 Images Transformations；留空则从站点根路径读取
IMAGE_BASE_URL=

# Clerk 开发实例密钥；publishable key 会随 SSR 状态传给浏览器
# 由服务端在运行时读取并交给 ClerkProvider，无需构建工具前缀
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 以下仅供本地上传/迁移脚本使用，不会上传到 Worker
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
