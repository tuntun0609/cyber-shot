{
  "name": "cyber-shot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/generate-previews.ts && rsbuild build",
    "check": "ultracite check",
    "deploy": "bun run build && wrangler deploy",
    "dev": "bun run scripts/generate-previews.ts && rsbuild dev",
    "fix": "ultracite fix",
    "format": "biome format --write",
    "lint": "biome check",
    "prepare": "lefthook install",
    "start": "wrangler dev --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@unpic/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.79.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "unpic": "^4.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@rsbuild/core": "2.3.4",
    "@rsbuild/plugin-react": "2.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "ultracite": "8.3.1",
    "wrangler": "4.168.0"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "trustedDependencies": [
    "sharp"
  ]
