{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cyber-shot",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "IMAGE_BASE_URL": "https://oss.tuntun.site",
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY3liZXItc2hvdC50dW50dW4uc2l0ZSQ"
  },
  "routes": [
    {
      "pattern": "cyber-shot.tuntun.site",
      "custom_domain": true
    }
  ],
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "oss"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyber-shot",
      "database_id": "3678e548-e967-4f77-bfa9-b4a3a3b214ab",
      "migrations_dir": "drizzle"
    }
  ]
}
